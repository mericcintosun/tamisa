# Tamisa needs no secret. ADAPTER_MODE picks the data source behind lib/adapter.ts.
# OWL-ViT runs in the browser through Transformers.js and downloads its weights from
# the public Hugging Face hub with no key. Bags you log stay in the browser
# (sessionStorage for the bag in progress, localStorage for saved bags).

# fake (default): serve the seeded Northgate audit from fixtures/northgate-fall-2026.json.
# real: reserved for Phase 2; for now it serves the same fixture, labelled "real".
ADAPTER_MODE=fake

# NEXT_PUBLIC_BRAND_FILES is set by next.config.ts at build time. Leave it unset here.
# NEXT_PUBLIC_BRAND_FILES=
